+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+/* ---------- Base ---------- */
+@layer base {
+  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
+
+  body {
+    min-width: 320px;
+    min-height: 100vh;
+    background: var(--bg-page);
+    color: var(--text-body);
+    font-family: var(--font-body);
+    font-size: 16px;
+    line-height: 1.5;
+    -webkit-font-smoothing: antialiased;
+    transition: background-color var(--transition), color var(--transition);
+  }
+
+  h1, h2, h3, h4 { font-family: var(--font-heading); color: var(--text-strong); }
+  button { cursor: pointer; }
+  button:disabled { cursor: not-allowed; }
+  img { max-width: 100%; }
+
+  ::selection { background: var(--color-primary-600); color: var(--on-primary); }
+
+  :focus-visible {
+    outline: 3px solid var(--color-focus-ring);
+    outline-offset: 3px;
+    border-radius: var(--radius-sm);
+  }
+
+  /* themed scrollbar */
+  * { scrollbar-width: thin; scrollbar-color: var(--color-gray-300) transparent; }
+}
+
+/* ---------- Layout (Knowledge §2.6) ---------- */
+@layer components {
+  .container {
+    width: 100%;
+    max-width: var(--container-max);
+    margin-inline: auto;
+    padding-inline: var(--page-padding);
+  }
+  .page { min-height: calc(100vh - var(--header-height)); }
+
+  /* section heading with a brand accent bar */
+  .section-title {
+    position: relative;
+    padding-left: var(--space-4);
+    font-family: var(--font-heading);
+    font-weight: 700;
+    color: var(--text-strong);
+    line-height: 1.15;
+  }
+  .section-title::before {
+    content: '';
+    position: absolute; left: 0; top: .12em; bottom: .12em;
+    width: 5px; border-radius: var(--radius-pill);
+    background: linear-gradient(180deg, var(--color-primary-600), var(--color-accent-600));
+  }
+
+  .eyebrow {
+    font-size: 12px; line-height: 16px; font-weight: 600;
+    letter-spacing: .14em; text-transform: uppercase;
+    color: var(--color-accent-600);
+  }
+
+  .text-gradient {
+    background: linear-gradient(100deg, var(--color-white) 10%, var(--color-focus-ring) 55%, var(--color-accent-600));
+    -webkit-background-clip: text; background-clip: text; color: transparent;
+  }
+
+  /* hero */
+  .hero {
+    position: relative; isolation: isolate; overflow: hidden;
+    border-radius: var(--radius-xl);
+    color: var(--color-white);
+    background: linear-gradient(120deg, var(--hero-from), var(--hero-to));
+    box-shadow: var(--shadow-lg);
+  }
+  .hero__img {
+    position: absolute; inset: 0; z-index: -2;
+    width: 100%; height: 100%; object-fit: cover; opacity: .45;
+    mix-blend-mode: luminosity;
+  }
+  .hero::before { /* colour wash */
+    content: ''; position: absolute; inset: 0; z-index: -1;
+    background:
+      radial-gradient(60% 80% at 85% 10%, color-mix(in srgb, var(--color-primary-600) 55%, transparent), transparent 70%),
+      radial-gradient(50% 70% at 0% 100%, color-mix(in srgb, var(--color-accent-600) 40%, transparent), transparent 70%),
+      linear-gradient(90deg, var(--hero-from) 25%, transparent 85%);
+  }
+  .hero::after { /* grain */
+    content: ''; position: absolute; inset: 0; z-index: -1; opacity: .12; pointer-events: none;
+    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
+  }
+
+  /* glass surface (header, floating panels) */
+  .glass {
+    background: color-mix(in srgb, var(--bg-header) 82%, transparent);
+    -webkit-backdrop-filter: saturate(180%) blur(14px);
+    backdrop-filter: saturate(180%) blur(14px);
+    border-bottom: 1px solid color-mix(in srgb, var(--on-header) 12%, transparent);
+  }
+
+  /* animated underline for nav links */
+  .nav-link { position: relative; }
+  .nav-link::after {
+    content: ''; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px;
+    background: var(--color-primary-600); border-radius: var(--radius-pill);
+    transform: scaleX(0); transform-origin: left; transition: transform var(--transition);
+  }
+  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); }
+
+  /* skeleton shimmer */
+  .shimmer { position: relative; overflow: hidden; background: var(--color-gray-200); }
+  .shimmer::after {
+    content: ''; position: absolute; inset: 0; transform: translateX(-100%);
+    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bg-card) 70%, transparent), transparent);
+    animation: shimmer-run 1.4s infinite;
+  }
+  @keyframes shimmer-run { 100% { transform: translateX(100%); } }
+
+  /* marquee ticker */
+  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
+  .marquee__track { display: flex; width: max-content; }
+
+  /* category tile */
+  .tile { position: relative; overflow: hidden; isolation: isolate; }
+  .tile::before {
+    content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0;
+    background: radial-gradient(120% 120% at 100% 0%, color-mix(in srgb, var(--color-primary-600) 28%, transparent), transparent 60%);
+    transition: opacity var(--transition);
+  }
+  .tile:hover::before { opacity: 1; }
+
+  /* cursor (see CursorFx) */
+  .cursor-ring, .cursor-dot {
+    position: fixed; top: 0; left: 0; z-index: 99999; pointer-events: none;
+    border-radius: 50%; will-change: transform;
+  }
+  .cursor-ring {
+    width: 36px; height: 36px; margin: -18px 0 0 -18px;
+    border: 2px solid var(--color-primary-600);
+    transition: width .18s ease-out, height .18s ease-out, margin .18s ease-out, background-color .18s ease-out, opacity .18s;
+    opacity: 0;
+  }
+  .cursor-ring.is-visible { opacity: .9; }
+  .cursor-ring.is-active {
+    width: 56px; height: 56px; margin: -28px 0 0 -28px;
+    background: color-mix(in srgb, var(--color-primary-600) 18%, transparent);
+  }
+  .cursor-ring.is-down { width: 28px; height: 28px; margin: -14px 0 0 -14px; }
+  .cursor-dot { width: 6px; height: 6px; margin: -3px 0 0 -3px; background: var(--color-primary-600); opacity: 0; }
+  .cursor-dot.is-visible { opacity: 1; }
+}
+
+@layer utilities {
+  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
+  .scrollbar-hide::-webkit-scrollbar { display: none; }
+  .pt-header { padding-top: var(--header-height); }
+}
+
+/* ---------- Accessibility: reduced motion ---------- */
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after {
+    animation-duration: .01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .01ms !important;
+  }
+}
